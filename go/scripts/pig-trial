#!/usr/bin/env bash
# pig-trial — one-key launcher for the isolated PiG trial (第 6 批 第 1 步).
#
# The trial keeps every moving part away from production:
#
#   * the coding agent runs under PIG_HOME=$PIG_TRIAL_HOME (default
#     /root/.pig-test), never under the production /root/.pi;
#   * the herdsman daemon is the *isolated* Go daemon whose home is
#     $HERDSMAN_TRIAL_HOME (default /root/.herdsman-go-trial), so the
#     production socket /root/.herdsman/herdsman.sock and the production
#     database are never contacted;
#   * the agent's extension directory (PIG_HOME/agent/extensions) holds the
#     17 Go extensions, so a plain `pig` start loads all of them.
#
# Usage:
#   pig-trial                       interactive PiG session (TUI)
#   pig-trial -p --no-session       one-shot prompt (stdin carries the prompt)
#   pig-trial --version             PiG version under the trial home
#
# Safety gates (both refuse with exit code 2, before anything is touched):
#   * PIG_TRIAL_HOME must not be empty and must not resolve to /root/.pi,
#     /root/.pi/agent, $HOME/.pi or $HOME/.pi/agent;
#   * HERDSMAN_TRIAL_HOME must not be empty and must not resolve to
#     /root/.herdsman or $HOME/.herdsman.
#
# Environment overrides:
#   PIG_TRIAL_HOME        isolated PiG home      (default /root/.pig-test)
#   HERDSMAN_TRIAL_HOME   isolated herdsman home (default /root/.herdsman-go-trial)
#   HERDSMAN_GO_TRIAL_BIN the trial daemon script (default
#                         /root/.local/lib/herdsman-go/herdsman-go-trial)
#   PIG_BIN               the PiG binary        (default /root/.local/bin/pig)
set -euo pipefail

PRODUCTION_PIG_HOME=/root/.pi
PRODUCTION_HERDSMAN_HOME=/root/.herdsman

# An explicitly empty value is *not* replaced by the default: the gates below
# have to see the empty value and refuse it.
PIG_TRIAL_HOME="${PIG_TRIAL_HOME-/root/.pig-test}"
HERDSMAN_TRIAL_HOME="${HERDSMAN_TRIAL_HOME-/root/.herdsman-go-trial}"

TRIAL_DAEMON_BIN="${HERDSMAN_GO_TRIAL_BIN:-/root/.local/lib/herdsman-go/herdsman-go-trial}"
PIG_BIN="${PIG_BIN:-/root/.local/bin/pig}"

die() {
  local code="$1"
  shift
  echo "pig-trial: $*" >&2
  exit "$code"
}

resolve_path() {
  realpath -m -- "$1"
}

# resolve_pig_trial_home is the hard gate for the coding agent home: the trial
# must never point PiG at the production agent directory.
resolve_pig_trial_home() {
  local raw="$1"
  [ -n "$raw" ] || die 2 "PIG_TRIAL_HOME is empty; refusing to run"
  local resolved home_pi
  resolved=$(resolve_path "$raw")
  home_pi=$(resolve_path "${HOME:-/root}/.pi")
  case "$resolved" in
    "$PRODUCTION_PIG_HOME" | "$PRODUCTION_PIG_HOME/agent" | "$home_pi" | "$home_pi/agent")
      die 2 "PIG_TRIAL_HOME resolves to the production agent directory '$resolved'; refusing to run"
      ;;
  esac
  printf '%s\n' "$resolved"
}

# resolve_herdsman_trial_home is the hard gate for the daemon home: the trial
# must never point at the production herdsman home.
resolve_herdsman_trial_home() {
  local raw="$1"
  [ -n "$raw" ] || die 2 "HERDSMAN_TRIAL_HOME is empty; refusing to run"
  local resolved home_herdsman
  resolved=$(resolve_path "$raw")
  home_herdsman=$(resolve_path "${HOME:-/root}/.herdsman")
  case "$resolved" in
    "$PRODUCTION_HERDSMAN_HOME" | "$home_herdsman")
      die 2 "HERDSMAN_TRIAL_HOME resolves to the production home '$resolved'; refusing to run"
      ;;
  esac
  printf '%s\n' "$resolved"
}

PIG_TRIAL_HOME=$(resolve_pig_trial_home "$PIG_TRIAL_HOME")
HERDSMAN_TRIAL_HOME=$(resolve_herdsman_trial_home "$HERDSMAN_TRIAL_HOME")

# No ambient environment may point PiG at the production agent directory.
unset PIG_CODING_AGENT_DIR PIG_CODING_AGENT_SESSION_DIR PIG_USE_PI_DIRS

# The trial daemon reads its home from the environment; export the resolved
# value so the child resolves the very same directory.
export HERDSMAN_TRIAL_HOME

trial_socket="$HERDSMAN_TRIAL_HOME/herdsman.sock"

if [ ! -x "$TRIAL_DAEMON_BIN" ]; then
  die 1 "the isolated trial daemon script is missing or not executable: $TRIAL_DAEMON_BIN"
fi

# Start the isolated Go daemon. Its output goes to stderr so that the stdout
# of `pig` stays clean for `-p --mode json` consumers.
if ! "$TRIAL_DAEMON_BIN" start >&2; then
  die 1 "the isolated Go herdsman daemon did not start (see the output above)"
fi

if [ ! -e "$trial_socket" ]; then
  die 1 "the isolated socket $trial_socket does not exist after the daemon start"
fi
case "$(resolve_path "$trial_socket")" in
  "$HERDSMAN_TRIAL_HOME"/*) ;;
  *) die 1 "the socket $trial_socket is not inside the isolated home $HERDSMAN_TRIAL_HOME" ;;
esac

export PIG_HOME="$PIG_TRIAL_HOME"
export HERDSMAN_IMPL=go
export HERDSMAN_HOME="$HERDSMAN_TRIAL_HOME"
export HERDSMAN_SOCKET_PATH="$HERDSMAN_TRIAL_HOME/herdsman.sock"
export HERDSMAN_PID_PATH="$HERDSMAN_TRIAL_HOME/herdsman.pid"
export HERDSMAN_LOG_PATH="$HERDSMAN_TRIAL_HOME/logs/herdsman.log"
export HERDSMAN_AGY_STATE_DIR="$HERDSMAN_TRIAL_HOME/agy-hooks"

exec "$PIG_BIN" "$@"
