set -e

bun_dir="$(command -v bun >/dev/null 2>&1 && dirname "$(command -v bun)" || true)"
if [ -z "$bun_dir" ]; then
  bun_dir="$(mise where bun 2>/dev/null || true)"
fi
[ -n "$bun_dir" ] || { echo "bun: not found on PATH（提交门禁靠 bun 跑 lint/typecheck/test）" >&2; exit 1; }
export PATH="$bun_dir:$PATH"

bun x lint-staged
bun run typecheck
bun run test
bun run lint
bun run format:check
bun run db:check
