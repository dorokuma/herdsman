#!/bin/sh
set -e

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root/go"

if [ -n "$(gofmt -l .)" ]; then
  echo "gofmt: unformatted files under go/" >&2
  gofmt -l . >&2
  exit 1
fi

go vet -p 2 ./...
go test -p 2 ./...
go build -o /dev/null ./cmd/herdsman
go build -o /dev/null ./cmd/herdsman-daemon
